# TrustShield Environment Configuration
# Copy this to .env and fill in your API keys

# LLM Configuration (optional - system works without it using template fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Choose: "gemini/gemini-2.0-flash" or "gpt-4o-mini" or "template" (no LLM)
LLM_MODEL=template

# App settings
APP_NAME=TrustShield
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./trustshield.db

# Demo Mode (uses pre-computed results for guaranteed demo reliability)
DEMO_MODE=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Agent Thresholds
RISK_ALLOW_THRESHOLD=30
RISK_REVIEW_THRESHOLD=70
HIGH_CONFIDENCE_THRESHOLD=0.75

# Agent weights for fusion
RISK_AGENT_WEIGHT=0.40
AUTH_AGENT_WEIGHT=0.35
REVIEW_AGENT_WEIGHT=0.25
